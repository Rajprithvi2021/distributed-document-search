# Copy to .env for local runs. Every setting is documented in app/config.py.
# Defaults run fully in-memory (no external services). docker-compose.yml sets the
# Elasticsearch + Redis values for you.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Backends -----------------------------------------------------------------
SEARCH_BACKEND=memory              # elasticsearch | memory
STATE_BACKEND=memory               # redis | memory   (cache, rate limits, queue)

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me-elastic
ELASTICSEARCH_TENANCY=index_per_tenant   # index_per_tenant | shared_index
ELASTICSEARCH_SHARDS=1
ELASTICSEARCH_REPLICAS=0
ELASTICSEARCH_REFRESH=false              # false (eventual, ~1s) | wait_for (read-your-writes)

REDIS_URL=redis://:change-me-redis@localhost:6379/0

# --- Caching ------------------------------------------------------------------
CACHE_SEARCH_TTL_S=60
CACHE_SEARCH_STALE_TTL_S=600
CACHE_DOCUMENT_TTL_S=300
CACHE_LOCAL_TTL_S=2
SEARCH_VISIBILITY_S=1.5            # pages computed this soon after a write expire when the refresh window closes

# --- Resilience ---------------------------------------------------------------
RETRY_DEADLINE_S=3.0               # total time budget for retrying one dependency call

# --- Rate limiting (per tenant token bucket) -----------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=600
RATE_LIMIT_BURST=100
RATE_LIMIT_OVERRIDES={"tenant-premium": 6000}

# --- Indexing -----------------------------------------------------------------
INDEXING_MODE=sync                 # sync (201) | async (202 + queue + worker)
RUN_EMBEDDED_WORKER=true           # dev only; production runs `python -m app.workers.indexer`
INDEXING_BLOCK_MS=1000             # worker's blocking wait for new jobs (queue connection timeout covers it)

# --- Security -----------------------------------------------------------------
AUTH_MODE=header                   # header | api_key | jwt   (header is rejected in production)
# API_KEYS={"demo-key-a": "tenant-a", "demo-key-b": "tenant-b"}
# JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOW_ORIGINS=[]
MAX_REQUEST_BYTES=10485760
MAX_DOCUMENT_BYTES=1048576
