# Environment Configuration Template
# Copy this file to .env and update values

# Application
APP_NAME=distributed-document-search
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Elasticsearch
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_TIMEOUT=30
ELASTICSEARCH_RETRIES=3

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
REDIS_MAX_CONNECTIONS=50

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=1000
RATE_LIMIT_PERIOD=60

# Security
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Multi-tenancy
TENANT_ISOLATION_MODE=row_level  # or 'index_per_tenant'
ENABLE_TENANT_VALIDATION=True

# Monitoring
PROMETHEUS_ENABLED=True
OPENTELEMETRY_ENABLED=False
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Feature Flags
ENABLE_FUZZY_SEARCH=True
ENABLE_FACETED_SEARCH=True
ENABLE_HIGHLIGHTING=True
ENABLE_ASYNC_INDEXING=True

# Performance
SEARCH_PAGE_SIZE_DEFAULT=20
SEARCH_PAGE_SIZE_MAX=100
INDEX_BATCH_SIZE=1000
INDEX_BULK_TIMEOUT=30
